---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import LoadingIndicator from '../components/LoadingIndicator.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
}

const {
	title = 'Dejan Vasic - Software Engineer',
	description = 'Personal website and blog of Dejan Vasic, Staff Software Engineer specializing in React, TypeScript, Node.js, and cloud infrastructure.',
	type = 'website'
} = Astro.props;
const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, '');

// Create canonical URL by removing trailing slash and ensuring it's the full URL
// Handle both root path and sub-paths consistently
const cleanPath = pathname.replace(/\/$/, '') || '/';
const canonicalURL = new URL(cleanPath, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="system">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" type="image/x-icon" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Dejan Vasic" />

		<!-- Open Graph meta tags -->
		<meta property="og:site_name" content="Dejan Vasic" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={type} />

		<!-- Twitter Card meta tags -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="Dejan Vasic - Blog" href="/rss.xml" />
		<GoogleAnalytics />
		<ClientRouter />
		<title>{title}</title>

		<!-- Structured data for site name -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "Dejan Vasic",
				"alternateName": "Dejan Vasic - Software Engineer",
				"url": "https://dejan.vasic.com.au",
				"description": "Personal website and blog of Dejan Vasic, Staff Software Engineer specializing in React, TypeScript, Node.js, and cloud infrastructure.",
				"author": {
					"@type": "Person",
					"name": "Dejan Vasic",
					"jobTitle": "Staff Software Engineer",
					"url": "https://dejan.vasic.com.au"
				}
			}
		</script>
	</head>
	<body>
		<LoadingIndicator />
		<header class="site-header">
			<div class="header-container">
				<a href="/" class="wordmark" aria-label="dejan.vasic — home">dejan<span>.</span>vasic</a>
				<nav class="main-nav">
					<a href="/" class={normalizedPathname === '' ? 'active' : ''}>Home</a>
					<a href="/cv" class={normalizedPathname === '/cv' ? 'active' : ''}>CV</a>
					<a href="/projects" class={normalizedPathname.startsWith('/projects') ? 'active' : ''}
						>Projects</a
					>
					<a href="/blog" class={normalizedPathname.startsWith('/blog') ? 'active' : ''}>Blog</a>
				</nav>
				<div class="theme-toggle-slot">
					<ThemeToggle />
				</div>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="footer-container">
				<p>&copy; {new Date().getFullYear()} Dejan Vasic. All rights reserved.</p>
				<div class="social-links">
					<a href="https://github.com/dejanvasic85" target="_blank" rel="noopener noreferrer"
						>GitHub
					</a>
					<a
						href="https://www.linkedin.com/in/dejan-vasic/"
						target="_blank"
						rel="noopener noreferrer">LinkedIn</a
					>
					<a href="https://x.com/dejanvasic85" target="_blank" rel="noopener noreferrer">X</a>
					<a
						href="https://bsky.app/profile/dejanvasic.bsky.social"
						target="_blank"
						rel="noopener noreferrer">Blue Sky</a
					>
					<a href="https://medium.com/@dejanvasic24" target="_blank" rel="noopener noreferrer"
						>Medium</a
					>
				</div>
			</div>
		</footer>

		<script>
			import { initializeTransitions } from '../scripts/transitionEnhancer';
			initializeTransitions();
		</script>

		<script>
			let headerScrollHandler: (() => void) | null = null;

			function setupHeaderScrollShadow() {
				const header = document.querySelector<HTMLElement>('.site-header');
				if (!header) return;

				if (headerScrollHandler) {
					window.removeEventListener('scroll', headerScrollHandler);
				}

				headerScrollHandler = () => {
					header.classList.toggle('is-scrolled', window.scrollY > 4);
				};

				headerScrollHandler();
				window.addEventListener('scroll', headerScrollHandler, { passive: true });
			}

			document.addEventListener('astro:page-load', setupHeaderScrollShadow);
		</script>
	</body>
</html>

<!-- All styles are now in global.css -->
<style>
	.main-nav {
		grid-area: nav;
		display: flex;
		gap: 1.5rem;
		height: 44px;
		align-items: center;
		justify-content: flex-end;
	}

	.theme-toggle-slot {
		grid-area: toggle;
		display: flex;
		align-items: center;
	}

	.main-nav a {
		color: var(--color-text);
		font-weight: 500;
		transition: color 0.2s;
		padding: var(--space-sm);
	}

	.main-nav a:hover {
		text-decoration: none;
	}

	.main-nav a.active {
		border-bottom: 2px solid var(--color-primary);
	}

	.main-nav a:not(.active):hover {
		border-radius: var(--radius-sm);
		background-color: var(--color-background-hover);
	}

	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--color-border);
		padding: 2rem 0;
		background-color: var(--color-background-hover);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		border-bottom: 1px solid var(--color-border);
		padding: 1.25rem 0;
		background-color: var(--color-background);
		transition: box-shadow 0.2s ease;
	}

	.site-header.is-scrolled {
		box-shadow: var(--shadow-md);
	}

	.footer-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 var(--space-lg);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.footer-container p {
		color: var(--color-text-light);
		margin-bottom: 0;
	}

	@media print {
		.site-header {
			display: none;
		}

		.site-footer {
			display: none;
		}
	}

	@media (prefers-color-scheme: dark) {
		.site-footer {
			background-color: var(--color-background);
		}
	}

	.social-links {
		display: flex;
		gap: 1.5rem;
	}

	.social-links a {
		color: var(--color-text-light);
		transition: color 0.2s;
	}

	.social-links a:hover {
		color: var(--color-primary);
	}

	@media (max-width: 768px) {
		.main-nav {
			justify-content: center;
			flex-wrap: wrap;
		}

		.header-container {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'wordmark toggle'
				'nav nav';
			row-gap: 0.75rem;
			transition: row-gap 0.25s ease;
		}

		.wordmark,
		.theme-toggle-slot {
			max-height: 2.75rem;
			overflow: hidden;
			transition:
				max-height 0.25s ease,
				opacity 0.2s ease;
		}

		.site-header.is-scrolled .header-container {
			row-gap: 0;
		}

		.site-header.is-scrolled .wordmark,
		.site-header.is-scrolled .theme-toggle-slot {
			max-height: 0;
			opacity: 0;
		}

		.footer-container {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
		}

		.social-links {
			justify-content: center;
		}
	}
</style>
